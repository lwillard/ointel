{
  "name": "ointel",
  "version": "0.6.5",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A thoughtful space for connected ideas.",
  "author": "Ointel",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:vectors": "node scripts/check-vectors.mjs",
    "test:offline": "node scripts/check-offline.mjs",
    "test:package": "node scripts/smoke-packaged.mjs",
    "package": "npm run prepare:offline && npm run build && electron-builder",
    "package:mac": "node scripts/check-mac.cjs && npm run prepare:offline && npm run build && electron-builder --mac --arm64 --publish never",
    "test:speech": "node scripts/check-speech.mjs",
    "prepare:offline": "node scripts/prepare-offline-models.mjs",
    "security:audit": "node scripts/audit-dependencies.cjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@huggingface/transformers": "^4.3.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xyflow/react": "^12.8.5",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "^1.13.8",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "44.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "studio.ointel.app",
    "productName": "Ointel",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/@img/**",
      "node_modules/sharp/**",
      "node_modules/sherpa-onnx-*/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "14.2",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Ointel transcribes audio playing on this Mac into local meeting notes when you start live capture.",
        "NSMicrophoneUsageDescription": "Ointel includes your voice in local meeting notes only when you enable the microphone.",
        "NSScreenCaptureUsageDescription": "Ointel uses the system capture session to access meeting audio. Screen images are not saved."
      },
      "identity": "-",
      "notarize": false
    },
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "build/offline-models",
        "to": "models",
        "filter": [
          "**/*",
          "!**/*.download"
        ]
      }
    ],
    "beforePack": "./scripts/verify-offline-models.cjs"
  }
}
